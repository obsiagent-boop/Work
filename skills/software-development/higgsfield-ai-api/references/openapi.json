    "components": {
        "schemas": {
            "MotionSchema": {
                "type": "object",
                "properties": {
                    "angle": {
                        "enum": [
                            0,
                            90,
                            180,
                            270
                        ],
                        "type": "integer",
                        "title": "Angle"
                    },
                    "prompt": {
                        "type": "string",
                        "title": "Prompt"
                    },
                    "zoom_factor": {
                        "type": "number",
                        "title": "Zoom factor"
                    }
                },
                "required": [
                    "angle",
                    "prompt",
                    "zoom_factor"
                ]
            },
            "Style": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "Id",
                        "format": "uuid"
                    },
                    "name": {
                        "type": "string",
                        "title": "Name"
                    },
                    "prompt": {
                        "type": "string",
                        "title": "Prompt"
                    },
                    "is_custom": {
                        "type": "boolean",
                        "title": "Is Custom"
                    }
                },
                "required": [
                    "id",
                    "name",
                    "prompt",
                    "is_custom"
                ]
            },
            "Error": {
                "type": "object",
                "properties": {
                    "code": {
                        "type": "string",
                        "title": "Code"
                    },
                    "message": {
                        "type": "string",
                        "title": "Message"
                    }
                },
                "required": [
                    "code",
                    "message"
                ]
            },
            "ErrorResponse": {
                "type": "object",
                "properties": {
                    "error": {
                        "$ref": "#/components/schemas/Error"
                    }
                },
                "required": [
                    "error"
                ]
            },
            "OutputImage": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "Id",
                        "format": "uuid"
                    },
                    "url": {
                        "type": "string",
                        "title": "Url",
                        "format": "uri"
                    }
                },
                "required": [
                    "id",
                    "url"
                ]
            },
            "OutputVideo": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "Id",
                        "format": "uuid"
                    },
                    "url": {
                        "type": "string",
                        "title": "Url",
                        "format": "uri"
                    }
                },
                "required": [
                    "id",
                    "url"
                ]
            },
            "RequestStatus": {
                "type": "object",
                "properties": {
                    "status": {
                        "enum": [
                            "queued",
                            "in_progress",
                            "completed",
                            "failed",
                            "canceled",
                            "nsfw"
                        ],
                        "type": "string",
                        "title": "Status"
                    },
                    "images": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/OutputImage"
                        },
                        "title": "Images"
                    },
                    "video": {
                        "$ref": "#/components/schemas/OutputVideo"
                    },
                    "error": {
                        "$ref": "#/components/schemas/Error"
                    },
                    "request_id": {
                        "type": "string",
                        "title": "Request Id",
                        "format": "uuid"
                    },
                    "status_url": {
                        "type": "string",
                        "title": "Status Url",
                        "format": "uri"
                    },
                    "cancel_url": {
                        "type": "string",
                        "title": "Cancel Url",
                        "format": "uri"
                    }
                },
                "required": [
                    "status",
                    "request_id",
                    "status_url",
                    "cancel_url"
                ]
            }
        }
    }
}
